<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. The app is dark-only by design (see values-night). -->
    <style name="Theme.VaxiCov" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="android:statusBarColor">@color/background_overlay</item>
        <item name="android:windowBackground">@color/background_main</item>
        <item name="android:textColor">@color/colorLightGrey</item>
        <item name="android:textColorHint">@color/editTextBorder</item>
        <item name="android:popupMenuStyle">@style/Widget.VaxiCov.PopupMenu</item>
    </style>

    <style name="TextAppearance.VaxiCov.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="fontFamily">@font/quantico</item>
        <item name="android:fontFamily">@font/quantico</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.VaxiCov.Input" parent="Widget.AppCompat.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/custom_input</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:fontFamily">@font/roboto_condensed_regular</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/colorLightGrey</item>
        <item name="android:textColorHint">@color/editTextBorderLight</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.VaxiCov.PopupMenu" parent="@android:style/Widget.PopupMenu">
        <item name="android:popupBackground">@color/background_overlay</item>
    </style>
</resources>
