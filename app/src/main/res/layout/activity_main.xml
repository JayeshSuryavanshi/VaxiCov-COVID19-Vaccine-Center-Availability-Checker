<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/background_overlay"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Dark"
        app:subtitleTextColor="@color/editTextBorderLight"
        app:title="@string/app_name"
        app:titleTextAppearance="@style/TextAppearance.VaxiCov.Title"
        app:titleTextColor="@color/colorOrange" />

    <!-- Search form -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/custom_input"
        android:orientation="vertical"
        android:padding="16dp">

        <RadioGroup
            android:id="@+id/rg_findby"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/pink_out_line"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/findbypin"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="1dp"
                android:layout_weight="1"
                android:background="@drawable/toggle_widget_background"
                android:button="@null"
                android:checked="true"
                android:fontFamily="@font/roboto_condensed_bold"
                android:gravity="center"
                android:text="@string/find_by_pincode"
                android:textColor="@color/colorLightGrey" />

            <RadioButton
                android:id="@+id/findbydistrict"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="1dp"
                android:layout_weight="1"
                android:background="@drawable/toggle_widget_background"
                android:button="@null"
                android:fontFamily="@font/roboto_condensed_bold"
                android:gravity="center"
                android:text="@string/find_by_district"
                android:textColor="@color/colorLightGrey" />
        </RadioGroup>

        <EditText
            android:id="@+id/et_pin"
            style="@style/Widget.VaxiCov.Input"
            android:layout_marginTop="16dp"
            android:drawableStart="@drawable/custom_pin_icon"
            android:hint="@string/hint_pincode"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="6" />

        <AutoCompleteTextView
            android:id="@+id/et_state"
            style="@style/Widget.VaxiCov.Input"
            android:layout_marginTop="16dp"
            android:completionThreshold="1"
            android:drawableStart="@drawable/custom_pin_icon"
            android:hint="@string/hint_state"
            android:imeOptions="actionNext"
            android:inputType="textCapWords"
            android:visibility="gone" />

        <AutoCompleteTextView
            android:id="@+id/et_district"
            style="@style/Widget.VaxiCov.Input"
            android:layout_marginTop="12dp"
            android:completionThreshold="1"
            android:drawableStart="@drawable/custom_pin_icon"
            android:hint="@string/hint_district"
            android:imeOptions="actionDone"
            android:inputType="textCapWords"
            android:visibility="gone" />

        <EditText
            android:id="@+id/et_agegroup"
            style="@style/Widget.VaxiCov.Input"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:cursorVisible="false"
            android:drawableStart="@drawable/custom_agegroup_icon"
            android:focusable="false"
            android:hint="@string/hint_age_group"
            android:importantForAutofill="no"
            android:inputType="none" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_dose"
                style="@style/Widget.VaxiCov.Input"
                android:layout_width="0dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="false"
                android:hint="@string/hint_dose"
                android:importantForAutofill="no"
                android:inputType="none" />

            <EditText
                android:id="@+id/et_vaccine"
                style="@style/Widget.VaxiCov.Input"
                android:layout_width="0dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="false"
                android:hint="@string/hint_vaccine"
                android:importantForAutofill="no"
                android:inputType="none" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/colorOrange"
                android:fontFamily="@font/roboto_condensed_bold"
                android:text="@string/action_search"
                android:textAllCaps="false"
                android:textColor="@color/colorLightGrey"
                android:textSize="16sp"
                app:cornerRadius="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_notify"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/colorGreen"
                android:fontFamily="@font/roboto_condensed_bold"
                android:text="@string/action_notify_me"
                android:textAllCaps="false"
                android:textColor="@color/colorLightGrey"
                android:textSize="16sp"
                app:cornerRadius="6dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_notifier_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:drawableStart="@drawable/notification_icon"
        android:drawablePadding="8dp"
        android:fontFamily="@font/roboto_condensed_regular"
        android:gravity="center_vertical"
        android:textColor="@color/colorGreen"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="Watching pincode 422011 (All) every 15 minutes"
        tools:visibility="visible" />

    <!-- Results -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_centers"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            tools:listitem="@layout/item_center" />

        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/roboto_condensed_regular"
            android:gravity="center"
            android:padding="24dp"
            android:textColor="@color/colorLightGrey"
            android:textSize="16sp"
            android:visibility="gone"
            tools:text="@string/error_network"
            tools:visibility="visible" />

        <ProgressBar
            android:id="@+id/progressbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
